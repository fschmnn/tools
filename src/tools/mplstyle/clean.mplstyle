# ---------------------------------------------------------------------

# --------------------------------------------------------------------- 
# colorcycle of the lines and width
# ---------------------------------------------------------------------

#figure.dpi : 300
figure.figsize:     8, 4.94  # figure size in inches (A4 width golden ratio)
font.size:        10

# 'f9d200','de1663','263d83','287b56'

axes.prop_cycle: cycler('color',['e15759','4e79a7','f28e2b','76b7b2','59a14e','edc949','b07aa2','ff9da7','9c755f','bab0ac'])

scatter.marker:    o

xtick.top:           False
xtick.direction:     in


ytick.left:          False    # draw ticks on the left side
ytick.right:         False   # draw ticks on the right side

axes.grid:          True   # display grid or not
axes.grid.axis:     y     # which axis the grid should apply to
axes.axisbelow: true

axes.linewidth: 1.0     # edge line width
grid.linewidth: 0.5     # in points

axes.spines.left:   False  # display axis spines
axes.spines.bottom: True
axes.spines.top:    True
axes.spines.right:  False

axes.edgecolor: b0b0b0   # ci
xtick.color:    b0b0b0   # color of the ticks
xtick.labelcolor:   444444
ytick.labelcolor:   444444
axes.labelcolor:    222222
axes.titlecolor:    222222