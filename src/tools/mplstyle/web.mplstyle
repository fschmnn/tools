# ===================================================================== 
#           Minimalistic style for web and digital representation
#
# a full list of parameters can be found here
# https://matplotlib.org/stable/users/explain/customizing.html
#
#                                                (C) Fabian Scheuermann
# ===================================================================== 

figure.dpi :    300      # decent resolution to show on screen 
figure.figsize: 8, 4.94  # in inches (fit A4 width golden ratio)
font.size:      10       # 

axes.prop_cycle: cycler('color',['e15759','4e79a7','f28e2b','76b7b2','59a14e','edc949','b07aa2','ff9da7','9c755f','bab0ac'])

axes.labelcolor:  222222  # color of xlabel and ylabel
axes.titlecolor:  222222  # color for ax.set_title
axes.edgecolor:   b0b0b0  # 
xtick.color:      b0b0b0  # color of the ticks
xtick.labelcolor: 444444  # color of xtick_labels
ytick.labelcolor: 444444  # color of ytick_labels

xtick.direction: in     # direction: {in, out, inout}
xtick.top:       False  # draw no ticks on the top side
ytick.left:      False  # draw no ticks on the left side
ytick.right:     False  # draw no ticks on the right side

axes.grid:      True  # display a grid
axes.grid.axis: y     # which axis the grid should apply to
axes.axisbelow: True  # draw axis gridlines and ticks:
                      #     - below patches (True)
                      #     - above patches but below lines ('line')
                      #     - above all (False)

axes.linewidth: 1.0  # edge line width
grid.linewidth: 0.5  # in points

axes.spines.left:   False  # display axis spines
axes.spines.bottom: True
axes.spines.top:    True
axes.spines.right:  False

scatter.marker:    o
